{
  "name": "videosearch-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main/index.js",
  "scripts": {
    "electron": "electron .",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "node scripts/build-backend.js",
    "dist:dir": "npm run build:frontend && npm run build:backend && electron-builder --win dir --publish never",
    "dist:win": "npm run build:frontend && npm run build:backend && electron-builder --win --publish never",
    "dist:mac": "npm run build:frontend && npm run build:backend && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.videosearch.desktop",
    "productName": "VideoSearch",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "ddll8023",
      "repo": "LocalVideoSearch",
      "releaseType": "release"
    },
    "files": [
      "package.json",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/dist",
        "to": "backend",
        "filter": [
          "backend",
          "backend.exe"
        ]
      },
      {
        "from": "frontend/dist",
        "to": "frontend/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.entertainment",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        "dir",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VideoSearch"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
